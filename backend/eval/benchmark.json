{
  "description": "DevPilot Benchmark v2 \u2014 deterministic repository-repair + QA tasks across 9 categories, each pinned to a bundled fixture repo with a real failing test. Repair cases are scored against a no-RAG baseline and prompt versions v1/v2/v3.",
  "repos": {
    "sample_app": "examples/sample_app",
    "bank_app": "examples/bank_app",
    "cart_app": "examples/cart_app",
    "auth_app": "examples/auth_app",
    "inventory_app": "examples/inventory_app",
    "shopcore": "examples/shopcore",
    "webapp": "examples/webapp",
    "securestore": "examples/securestore",
    "datapipe": "examples/datapipe",
    "formsvc": "examples/formsvc"
  },
  "cases": [
    {
      "id": "repair_tax",
      "type": "repair",
      "category": "retrieval-distractor",
      "repo": "shopcore",
      "bug": "Adding tax to an amount returns the wrong total (it returns just the tax, not amount plus tax).",
      "expected_files": [
        "tax.py"
      ],
      "test_path": "tests/test_tax.py",
      "expected_test": "tests/test_tax.py::test_add_tax",
      "expected_keywords": [
        "tax",
        "amount"
      ]
    },
