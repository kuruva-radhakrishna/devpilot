# ============================================================
# DevPilot configuration — copy this file to `.env` and fill in.
#   cp .env.example .env   (macOS/Linux)
#   copy .env.example .env (Windows)
# ============================================================

# --- LLM provider ---
# "gemini" (default) or "ollama" (local models — no key, no quota).
# The whole stack is provider-independent; this just picks the backend.
LLM_PROVIDER=gemini

# --- Google Gemini ---
# Get a free API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# gemini-embedding-001 supports 128-3072 dims; we request 768 (matches DB schema).
# Run `python -m app.list_models` (or check AI Studio) if a model name 404s —
# available models vary by key and change over time.
EMBED_DIM=768

# --- Vector store backend ---
# "memory"  -> zero-infra numpy cosine search (great for first run / demos)
# "pgvector" -> PostgreSQL + pgvector (production-style; needs docker-compose up)
VECTOR_BACKEND=memory

# --- PostgreSQL (only used when VECTOR_BACKEND=pgvector) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=devpilot
POSTGRES_USER=devpilot
POSTGRES_PASSWORD=change_me

# --- Agent ---
# Max tool-call iterations before the agent must give a final answer.
AGENT_MAX_STEPS=8
# Which prompt version to use (maps to backend/app/agent/prompts/<task>/<version>.txt)
PROMPT_VERSION=v1

# --- Retrieval ---
RETRIEVAL_TOP_K=8
# Where cloned/ingested repos live on disk.
REPO_CACHE_DIR=./.repo_cache

# --- Sandbox (test execution for the repair loop) ---
# "docker"   -> isolated container (recommended). Build the image first:
#                 docker build -t devpilot-sandbox:latest backend/app/sandbox
# "local"    -> host subprocess, NOT isolated (dev fallback when Docker is absent)
# "disabled" -> run_tests returns a stub
SANDBOX_BACKEND=docker
SANDBOX_IMAGE=devpilot-sandbox:latest
SANDBOX_MEMORY=512m
SANDBOX_CPUS=1.0
SANDBOX_PIDS_LIMIT=256
SANDBOX_TIMEOUT=120
WORKSPACE_DIR=./.workspaces

# --- Repair loop ---
# How many patch attempts before giving up on a fix.
REPAIR_MAX_ITERS=3

# --- Observability (lifecycle tracing) ---
TRACE_ENABLED=true
TRACES_DIR=./traces

# --- Ollama (only used when LLM_PROVIDER=ollama) ---
# Requires a running Ollama server with these models pulled:
#   ollama pull qwen2.5-coder:7b && ollama pull nomic-embed-text
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
